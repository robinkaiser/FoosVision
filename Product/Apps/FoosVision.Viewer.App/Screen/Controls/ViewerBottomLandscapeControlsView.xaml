<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FoosVision.Viewer.App.Screen.Controls"
             x:Class="FoosVision.Viewer.App.Screen.Controls.ViewerBottomLandscapeControlsView"
             x:DataType="controls:ViewerControlsViewModel">
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="16"
          VerticalOptions="Center">
        <HorizontalStackLayout Grid.Column="0"
                               Spacing="14"
                               HorizontalOptions="Start"
                               VerticalOptions="Center">
            <Label Text="{Binding FpsLabelText}"
                   IsVisible="{Binding IsStreamFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="40"
                   Rotation="{Binding ControlsRotationDegrees}" />
            <Label Text="{Binding StreamFpsText}"
                   IsVisible="{Binding IsStreamFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="40"
                   Rotation="{Binding ControlsRotationDegrees}" />
            <Label Text="{Binding TrackingFpsText}"
                   IsVisible="{Binding IsTrackingFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="40"
                   Rotation="{Binding ControlsRotationDegrees}" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Column="2"
                               Spacing="10"
                               HorizontalOptions="End"
                               VerticalOptions="Center">
            <Button Text="{Binding InstallButton.Text}"
                    Command="{Binding ToggleInstallModeCommand}"
                    IsEnabled="{Binding InstallButton.IsEnabled}"
                    BackgroundColor="{Binding InstallButton.BackgroundColor}"
                    TextColor="{Binding InstallButton.TextColor}"
                    BorderColor="{Binding InstallButton.BorderColor}"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    HeightRequest="40"
                    MinimumWidthRequest="104"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
            <Button Text="{Binding GameButton.Text}"
                    Command="{Binding ToggleGameModeCommand}"
                    IsEnabled="{Binding GameButton.IsEnabled}"
                    BackgroundColor="{Binding GameButton.BackgroundColor}"
                    TextColor="{Binding GameButton.TextColor}"
                    BorderColor="{Binding GameButton.BorderColor}"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    HeightRequest="40"
                    MinimumWidthRequest="104"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
            <Button Text="About"
                    Command="{Binding OpenAboutCommand}"
                    BackgroundColor="#761C222C"
                    TextColor="#D7DEE8"
                    BorderColor="#94637080"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    HeightRequest="40"
                    MinimumWidthRequest="104"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
        </HorizontalStackLayout>
    </Grid>
</ContentView>
