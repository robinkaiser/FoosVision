<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FoosVision.Viewer.App.Screen.Controls"
             x:Class="FoosVision.Viewer.App.Screen.Controls.ViewerSideLandscapeControlsView"
             x:DataType="controls:ViewerControlsViewModel">
    <Grid RowDefinitions="Auto,*,Auto"
          RowSpacing="16"
          HorizontalOptions="Center">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="10"
                             HorizontalOptions="Center"
                             VerticalOptions="Start">
            <Label Text="{Binding FpsLabelText}"
                   IsVisible="{Binding IsStreamFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="24"
                   Rotation="{Binding ControlsRotationDegrees}" />
            <Label Text="{Binding StreamFpsText}"
                   IsVisible="{Binding IsStreamFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="24"
                   Rotation="{Binding ControlsRotationDegrees}" />
            <Label Text="{Binding TrackingFpsText}"
                   IsVisible="{Binding IsTrackingFpsVisible}"
                   TextColor="#D7DEE8"
                   FontSize="11"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Center"
                   LineBreakMode="NoWrap"
                   HeightRequest="24"
                   Rotation="{Binding ControlsRotationDegrees}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="10"
                             HorizontalOptions="Center"
                             VerticalOptions="End">
            <Button Text="{Binding InstallButton.Text}"
                    Command="{Binding ToggleInstallModeCommand}"
                    IsEnabled="{Binding InstallButton.IsEnabled}"
                    BackgroundColor="{Binding InstallButton.BackgroundColor}"
                    TextColor="{Binding InstallButton.TextColor}"
                    BorderColor="{Binding InstallButton.BorderColor}"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    WidthRequest="104"
                    HeightRequest="40"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
            <Button Text="{Binding GameButton.Text}"
                    Command="{Binding ToggleGameModeCommand}"
                    IsEnabled="{Binding GameButton.IsEnabled}"
                    BackgroundColor="{Binding GameButton.BackgroundColor}"
                    TextColor="{Binding GameButton.TextColor}"
                    BorderColor="{Binding GameButton.BorderColor}"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    WidthRequest="104"
                    HeightRequest="40"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
            <Button Text="About"
                    Command="{Binding OpenAboutCommand}"
                    BackgroundColor="#761C222C"
                    TextColor="#D7DEE8"
                    BorderColor="#94637080"
                    BorderWidth="1"
                    CornerRadius="10"
                    Padding="10,0"
                    WidthRequest="104"
                    HeightRequest="40"
                    FontSize="11"
                    Rotation="{Binding ControlsRotationDegrees}" />
        </VerticalStackLayout>
    </Grid>
</ContentView>
