<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <RootNamespace>FoosVision.Recorder.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Use MAUI XAML source generation for recorder pages and resources. -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">33.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Adapters\FoosVision.Adapters.Recorder\FoosVision.Adapters.Recorder.csproj" />
    <ProjectReference Include="..\..\Adapters\FoosVision.Protocol\FoosVision.Protocol.csproj" />
    <ProjectReference Include="..\..\Composition\FoosVision.Recorder.Composition\FoosVision.Recorder.Composition.csproj" />
    <ProjectReference Include="..\..\Infrastructure\FoosVision.Settings\FoosVision.Settings.csproj" />
    <ProjectReference Include="..\..\Infrastructure\FoosVision.Logging\FoosVision.Logging.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Media\FoosVision.Media.Android\FoosVision.Media.Android.csproj" />
  </ItemGroup>

</Project>
