<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style x:Key="RecorderTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource RecorderModeText}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="RecorderStatusLabel" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource RecorderConnectionStatusText}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="RecorderModeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource RecorderModeText}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <Style x:Key="RecorderActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource RecorderActionBackground}" />
        <Setter Property="TextColor" Value="{StaticResource RecorderActionText}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,8" />
    </Style>

    <Style x:Key="RecorderSecondaryActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource RecorderSecondaryActionBackground}" />
        <Setter Property="TextColor" Value="{StaticResource RecorderSecondaryActionText}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,8" />
    </Style>
</ResourceDictionary>
